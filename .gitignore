# ==============================================================================
# SmartMedChart Root Git Ignore Specification
# ==============================================================================

# Environment variables & secrets
.env
.env.*
*.env
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.pytest_cache/
.coverage
htmlcov/
*.egg-info/
.eggs/

# Virtual Environments
.venv/
venv/
env/
ENV/
backend/.venv/
backend/venv/

# Local databases & dumps
*.db
*.sqlite
*.sqlite3
backend/smartmedchart*.db
backend/mongodb_backup*/
mongodb_backup*/

# Node & Frontend Build
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/
package-lock.json.bak

# Logs & temporary files
*.log
logs/
scratch/
carematch_backup/
smartmedchart_backend_source.zip
*.tmp
*.bak

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

