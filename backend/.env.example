# ==============================================================================
# SmartMedChart Backend Environment Configuration Template
# DO NOT commit real secrets, passwords, or production keys to source control.
# Copy this file to '.env' and fill in your real values for local testing or Render.
# ==============================================================================

# MongoDB Connection
# Local Development: mongodb://127.0.0.1:27017
# For Atlas, replace this with a dedicated DEVELOPMENT-cluster URI. Do not use production data for local testing.
MONGODB_URI=mongodb://127.0.0.1:27017

# Target Database Name
# Local Dev:   smartmedchart_dev
# Local Tests: smartmedchart_e2e_test
# Production:  smartmedchart_production
MONGODB_DATABASE=smartmedchart_dev

# JWT Authentication
# Generate a strong 64-character secret key using: openssl rand -hex 32
JWT_SECRET_KEY=<your_64_character_hex_secret_key>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins
# Comma-separated list of allowed frontend domains. Do NOT use wildcards (*) with credentials.
# Add deployed Vercel origins in the production environment; keep local origins here for development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Application Environment Mode
# Set to 'production' on Render; 'development' locally
ENVIRONMENT=development

# 5-Minute Medication Notification Worker
# Set 'true' to run the scheduler inside the FastAPI web instance (best for single web dyno / Free Tier)
# Set 'false' if running a separate Render Background Worker running 'python worker.py'
ENABLE_EMBEDDED_SCHEDULER=true

# Notification Polling Interval (in seconds)
NOTIFICATION_POLL_INTERVAL=15

# Server Port (Render sets $PORT dynamically; default is 8000 for local runs)
PORT=8000

